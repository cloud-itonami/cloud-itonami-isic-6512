;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:dev:physics` runs it.
;;
;; README "Robotics premise": a claims-site damage-inspection drone documents
;; property and vehicle loss for the human adjuster (ISIC 6512, non-life
;; insurance). Flight itself is outside this solver set; what is declared here
;; is the ground work around it: the site rover that carries the drone kit over
;; a sloped, debris-strewn lot, and the re-entry decision after a fire loss
;; (how hot the unexposed face of a burned wall still is when inspected).
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-6512"
 :cases
 [{:id :drone-kit-rover-on-slope
   :kind :transport
   :procedure "site rover carries the inspection drone kit and batteries up a sloped driveway to the loss location"
   :params {:mass-kg 70.0 :payload-kg 25.0 :distance-m 40.0 :v-max-mps 1.0 :a-max-mps2 0.6
            :brake-decel-mps2 1.5 :drive-force-n 400.0 :crr 0.05
            :cog-height-m 0.40 :payload-cog-height-m 0.70 :support-half-length-m 0.30
            :max-time-s 1800.0}
   :sweep {:param :slope-deg :values [0.0 5.0 10.0 15.0 20.0]}
   :quantity :min-tipover-margin
   :limit {:min 0.3 :basis "estimate: keep 30 % of the static tip-over margin in reserve for debris bumps on an unsurveyed loss site"}
   :boundary {:lo 0.0 :hi 30.0}}
  {:id :fire-loss-wall-reentry
   :kind :thermal
   :procedure "30-minute room fire on one face of a masonry wall, then burn-out; the unexposed face the drone and adjuster approach, at the inspection time"
   :params {:thickness-m 0.10 :conductivity-w-mk 0.8 :density-kg-m3 1800.0 :specific-heat-j-kgk 900.0
            :hot-curve :iso-834 :heating-s 1800.0 :t-cool-c 20.0
            :h-front-w-m2k 25.0 :h-back-w-m2k 8.0 :threshold-c 50.0 :nodes 15}
   :sweep {:param :duration-s :values [3600.0 7200.0 14400.0 28800.0 43200.0]}
   :quantity :final-back-c
   :limit {:max 50.0 :basis "estimate: unexposed-face temperature below which a gloved adjuster can touch and core the wall"}
   :boundary {:lo 3600.0 :hi 86400.0}}
  {:id :damaged-sheet-coupon
   :kind :material
   :procedure "tensile coupon cut from a hail-dented steel roof sheet, tested to confirm the panel still meets its grade"
   :params {:length-m 0.05 :area-m2 1.25e-5 :youngs-modulus-pa 200.0e9 :hardening-pa 1.0e9
            :max-force-n 5000.0}
   :sweep {:param :yield-stress-pa :values [180.0e6 220.0e6 250.0e6 280.0e6 320.0e6]}
   :quantity :yield-force-n
   :limit {:min 3125.0 :basis "estimate: 250 MPa minimum yield (a common structural sheet grade) on the 12.5 mm2 coupon section"}
   :boundary {:lo 150.0e6 :hi 350.0e6}}]}
